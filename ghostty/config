font-family = JetBrainsMono Nerd Font Mono
font-size = 14

mouse-hide-while-typing = true

adjust-cell-height = 80%

window-save-state = always

window-colorspace = "display-p3"
window-padding-x = 16
window-padding-y = 0
window-padding-balance = true

window-height = 30
window-width = 120

macos-titlebar-style = tabs

# theme = Nord Wave
# theme = Kanagawa Dragon
# theme = Kanso Zen
# theme = Catppuccin Mocha
# theme = dark:Rose Pine,light:Rose Pine Dawn
# theme = Gruvbox Dark
# theme = Vesper
theme = Pnevma

# Background
background-opacity = 0.8
background-blur = true

# unfocused-split-opacity = 1


# keybinds
keybind = ctrl+a>shift+\=new_split:right
keybind = ctrl+a>-=new_split:down
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:top
keybind = super+down=goto_split:bottom

keybind = super+r=reload_config
keybind = shift+enter=text:\x1b\r
