// Zed settings
{
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "agent_ui_font_size": 15.0,
  "agent_buffer_font_size": 14.0,
  "diff_view_style": "split",
  "language_models": {
    "opencode": {
      "show_zen_models": false,
    },
  },
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "context_servers": {
    "shadcn": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ],
    },
    "laravel-boost": {
      "enabled": true,
      "remote": false,
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ],
    },
    "Astro docs": {
      "enabled": true,
      "url": "https://mcp.docs.astro.build/mcp",
    },
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_user_menu": false,
    "show_branch_name": true,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": true,
  },
  "gutter": {
    "min_line_number_digits": 0,
    "line_numbers": true,
  },
  "soft_wrap": "bounded",
  "show_wrap_guides": false,
  "icon_theme": "Soft Charmed Icons",
  "base_keymap": "VSCode",
  "agent": {
    "commit_message_model": {
      "provider": "opencode",
      "model": "minimax-m2.7"
    },
    "play_sound_when_agent_done": "when_hidden",
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "api.github.com"
      ],
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^php\\s+artisan(\\s|$)",
            },
            {
              "pattern": "^git\\b",
            },
            {
              "pattern": "^head\\b",
            },
            {
              "pattern": "^bunx\\s+tsc(\\s|$)",
            },
            {
              "pattern": "^grep\\b",
            },
            {
              "pattern": "^ls\\b",
            },
            {
              "pattern": "^gh\\s+issue(\\s|$)",
            },
          ],
        },
      },
    },
    "notify_when_agent_waiting": "all_screens",
    "default_profile": "write",
    "dock": "right",
    "commit_message_instructions": "Use the conventional commits format: <type>(<scope>): <description>\n\n[optional body]\n\n[optional footer(s)]",
    "default_model": {
      "effort": "max",
      "enable_thinking": true,
      "provider": "opencode",
      "model": "go/deepseek-v4-pro",
    },
  },
  "theme": "Lumin",
  "buffer_font_size": 14.0,
  "buffer_line_height": {
    "custom": 3.5,
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_size": 16,
  "confirm_quit": false,
  "vim_mode": true,
  "relative_line_numbers": "disabled",
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "project_panel": {
    "dock": "right",
    "default_width": 400,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "hide_root": true,
    "starts_open": false,
    "sticky_scroll": true,
    "entry_spacing": "comfortable",
    "indent_guides": {
      "show": "always",
    },
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 300,
    "indent_guides": {
      "show": "never",
    },
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "tab_bar": {
    "show": false,
  },
  "indent_guides": {
    "enabled": false,
  },
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "zsh",
        "args": [
          "-l"
        ],
        "title_override": null
      }
    }
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      },
      "binary": {
        "path": "bunx",
        "arguments": [
          "@biomejs/biome",
          "lsp-proxy"
        ],
      },
    },
    "wakatime": {
      "settings": {},
    },
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayVariableTypeHintsWhenTypeMatchesName": false,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true,
        },
      },
    },
  },
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "npx",
          "arguments": [
            "@biomejs/biome",
            "format",
            "--stdin-file-path",
            "{buffer_path}",
          ],
        },
      },
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "npx",
          "arguments": [
            "@biomejs/biome",
            "format",
            "--stdin-file-path",
            "{buffer_path}",
          ],
        },
      },
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
  },
}
