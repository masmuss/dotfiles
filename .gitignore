# ==========================================
# Root .gitignore for ~/.config repository
# ==========================================

# ------------------------------------------
# General system/editor files
# ------------------------------------------
# (macOS .DS_Store is already ignored in ~/.gitignore_global)
*~
*.bak
*.swp
*.orig

# System generated files
**/*.log
filezilla/lockfile
filezilla/queue.sqlite3
ghostty/auto/theme.ghostty

# ------------------------------------------
# Zsh Configuration
# ------------------------------------------
zsh/.secrets
zsh/.zprofile.local
zsh/*.pem
zsh/*.key
zsh/.zsh_history
zsh/.zsh_sessions/
zsh/.zhistory
zsh/.zcompdump*
zsh/*.zwc
zsh/.zshrc.kaku-backup-*

# ------------------------------------------
# Editors & IDEs
github-copilot/
zed/.tmp*
zed/conversations/
zed/embeddings/
zed/settings_backup.json
zed/prompts/
iterm2/sockets/

# Tools & Utilities
raycast/
configstore/
husky/
gh/
opencode/
acli/

# Tools - runtime data (not config)
psysh/
simple-update-notifier/
Autodesk/
jgit/
.mono/
